# Deriv API credentials (same account as the live EXPIRYRANGE bot --
# ticks_history is read-only, no trades are placed by this service)
DERIV_APP_ID=your_app_id_here
DERIV_API_TOKEN=your_api_token_here
DERIV_ACCOUNT_TYPE=demo
# DERIV_ACCOUNT_ID=CR123456

# Supabase -- must be the SAME project/keys as the live bot, so the model
# it writes is the one the live bot polls for
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Optional tuning (defaults shown)
# LSTM_TRAIN_SYMBOL=1HZ10V
# LSTM_TRAIN_HISTORY_DAYS=5
# LSTM_MAX_TICKS=300000
# LSTM_EPOCHS=15
# LSTM_BATCH_SIZE=256
# LSTM_LR=1e-3
