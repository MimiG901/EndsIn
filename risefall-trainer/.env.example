# Copy these into Railway → your trainer service → Variables.
# Never commit a real .env file with live values to git.

# ── Deriv API (required) — read-only history pull, no trading ────────────
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_ACCOUNT_TYPE=demo
DERIV_ACCOUNT_ID=

# ── Supabase persistence (required) ───────────────────────────────────────
# Same project as the bot service. Use the service_role key — this writes
# to bot_risefall_lstm_model.
SUPABASE_URL=
SUPABASE_KEY=

# ── Training config — all optional, sane defaults ─────────────────────────
# This deployment trains ONLY the minute model -- MODEL_KIND is fixed, not
# read from a loop like the tick+minute entrypoint.sh setup. The bot
# handles a permanently-absent tick model gracefully (lstm_duration_scan()
# just skips it), so this is a fully supported, simpler configuration.
MODEL_KIND=minute
# Comma-separated basket -- covers the same two symbol families the live
# bot draws from (see risefall-bot/README.md's "What Gate 6 actually
# changes"). Leave unset to use the built-in default basket. The singular
# RISEFALL_TRAIN_SYMBOL still works if you only want to train on one.
RISEFALL_TRAIN_SYMBOLS=1HZ10V,1HZ25V,1HZ50V,1HZ75V,1HZ100V,R_10,R_25,R_50,R_75,R_100
# History pull length PER SYMBOL. Minute mode needs far more raw ticks per
# symbol than tick mode to accumulate enough distinct one-minute bars.
LSTM_TRAIN_HISTORY_DAYS=30
# TOTAL tick budget across the WHOLE basket, divided evenly per symbol.
# Default for MODEL_KIND=minute is 800,000 (vs 300,000 for tick) -- kept
# under Deriv's observed ~24h/~86,400-tick ticks_history retention limit
# per symbol (going past it doesn't error, it silently wraps; the trainer
# now detects and stops cleanly at that boundary, but there's no point
# defaulting above it). Override only if a symbol turns out to retain
# more, or your basket size/Railway plan needs something different.
# LSTM_MAX_TICKS=800000
# Pooled example caps -- keep wall-clock time bounded regardless of how
# many symbols are in the basket. A full 10-symbol basket with NO cap
# measured out to ~2 CPU-hours for one MODEL_KIND run before this was
# added; with these defaults it's well under 20 minutes.
LSTM_MAX_TRAIN_EXAMPLES=20000
LSTM_MAX_VAL_EXAMPLES=4000
# v8: persistent minute-bar archive in Supabase (bot_risefall_minute_bars,
# see risefall-bot/README.md's SQL block). Works around Deriv's ~24h
# ticks_history retention limit -- every run upserts its freshly resampled
# bars into this table (deduped on symbol+epoch) and trains on the FULL
# accumulated history instead of just this run's fresh fetch. Also warm-
# starts every run from whatever model is currently live in Supabase
# instead of reinitializing from scratch -- both matter a lot more now
# that any single run's own fresh window is thin. Set
# LSTM_ARCHIVE_MINUTE_BARS=false to disable and go back to training on
# just each run's fresh fetch.
LSTM_ARCHIVE_MINUTE_BARS=true
LSTM_ARCHIVE_MAX_DAYS=45
LSTM_EPOCHS=15
LSTM_BATCH_SIZE=64
LSTM_LR=0.001
LSTM_ANCHOR_STRIDE=5
LSTM_COMBOS_PER_ANCHOR=4
LSTM_BAG_KEEP_PROB=0.8

# Abort the Supabase upload (keep serving whatever model is already live)
# if this run's LSTM doesn't beat a naive persistence baseline on its own
# held-out validation split. See the "BASELINE DIAGNOSTICS" section of
# risefall_lstm_train.py's module docstring.
LSTM_REQUIRE_BEAT_PERSISTENCE=true
